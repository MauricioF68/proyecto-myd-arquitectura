pipeline {
    agent any

    environment {
        TF_DIR = 'infrastructure/terraform'
        BACKEND_DIR = 'backend'
        // Nombre de la red de docker que viste en el paso 1
        DOCKER_NETWORK = 'proyecto-myd-arquitectura_cicd-net' 
    }

    stages {
        // ETAPA 1: CONSTRUCCIÓN Y PRUEBAS
        stage('Build & Test') {
            steps {
                script {
                    echo '--- 1. Construyendo Contenedor de Aplicación ---'
                    sh "docker build -t myd-app:latest ${BACKEND_DIR}"
                    
                    echo '--- 2. Ejecutando Pruebas Unitarias (PHPUnit) ---'
                    sh "docker run --rm myd-app:latest php artisan test"
                }
            }
        }

        // ETAPA 2: CALIDAD Y SEGURIDAD
        stage('Quality & Security') {
            parallel {
                stage('SonarQube Analysis (PHP)') {
                    steps {
                        script {
                            echo '--- Ejecutando Análisis Real de SonarQube ---'
                            // Usamos el plugin para obtener las credenciales (Token) automáticamente
                            withSonarQubeEnv('SonarQube Server') {
                                // Lanzamos un contenedor temporal con el escáner
                                // Le pasamos el código (-v) y lo conectamos a la red (--network)
                                sh """
                                docker run --rm \
                                    --network ${DOCKER_NETWORK} \
                                    -v "\$(pwd)/${BACKEND_DIR}:/usr/src" \
                                    sonarsource/sonar-scanner-cli \
                                    -Dsonar.projectKey=myd-controles-backend \
                                    -Dsonar.host.url=http://sonarqube:9000 \
                                    -Dsonar.login=\$SONAR_AUTH_TOKEN
                                """
                            }
                        }
                    }
                }
                
                stage('Infrastructure Security (Checkov)') {
                    steps {
                        echo '--- Ejecutando Auditoría de Terraform ---'
                        dir("${TF_DIR}") {
                            // Usamos tu archivo de configuración .checkov.yaml montando el volumen raíz
                            sh 'docker run --rm -v $(pwd)/../../:/tf bridgecrew/checkov:3 -d /tf/infrastructure/terraform --config-file /tf/.checkov.yaml --soft-fail'
                        }
                    }
                }
            }
        }

        // ETAPA 3: PLANIFICACIÓN DE INFRAESTRUCTURA
        stage('Terraform Plan') {
            steps {
                script {
                    echo '--- Planificando Infraestructura ---'
                    dir("${TF_DIR}") {
                        sh 'terraform init'
                        sh 'terraform plan -out=tfplan'
                    }
                }
            }
        }
        
        // ETAPA 4: DESPLIEGUE (Solo con aprobación)
        stage('Deploy to AWS') {
            input {
                message "¿Desplegar a Producción?"
                ok "Sí, dale"
            }
            steps {
                script {
                    echo '--- Desplegando... (Simulado) ---'
                    // sh 'terraform apply tfplan'
                }
            }
        }
    }
}