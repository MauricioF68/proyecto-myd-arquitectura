pipeline {
    agent any

    environment {
        // Rutas de directorio
        TF_DIR = 'infrastructure/terraform'
        BACKEND_DIR = 'backend'
        
        // Configuración de Docker/Redes
        DOCKER_NETWORK = 'proyecto-myd-arquitectura_cicd-net'
        
        // ID de credenciales de Jenkins (creado en el paso anterior)
        AWS_CREDENTIALS_ID = 'aws-credentials' 
    }

    stages {

        // ETAPA 2: CALIDAD Y SEGURIDAD
        stage('Quality & Security') {
            parallel {

                // ---- ANÁLISIS SONARQUBE (PHP) ----
                stage('SonarQube Analysis (PHP)') {
                    steps {
                        script {
                            echo '--- Ejecutando Análisis Real de SonarQube ---'
                            withSonarQubeEnv('SonarQube Server') {
                                sh """
                                docker run --rm \
                                    --network ${DOCKER_NETWORK} \
                                    -v "\$(pwd)/${BACKEND_DIR}:/usr/src" \
                                    sonarsource/sonar-scanner-cli \
                                    -Dsonar.projectKey=myd-controles-backend \
                                    -Dsonar.host.url=http://sonarqube:9000 \
                                    -Dsonar.login=\$SONAR_AUTH_TOKEN \
                                    -Dsonar.projectBaseDir=/usr/src 
                                    // CORRECCIÓN: Agregamos -Dsonar.projectBaseDir para que detecte el código en /usr/src
                                """
                            }
                        }
                    }
                }

                // ---- ANALISIS DE INFRAESTRUCTURA (CHECKOV) ----
                stage('Infrastructure Security (Checkov)') {
                    steps {
                        echo '--- Ejecutando Auditoría de Terraform ---'
                        dir("${TF_DIR}") {
                            // CORRECCIÓN: Se mantiene el volumen montado a la raíz del workspace 
                            // y se escanea el path interno dentro del contenedor: /tf/infrastructure/terraform
                            sh '''
                            docker run --rm \
                                -v $(pwd)/../../:/tf \
                                bridgecrew/checkov:3 \
                                -d /tf/infrastructure/terraform \
                                --soft-fail
                            '''
                        }
                    }
                }
            }
        }

        // ETAPA 3: PLANIFICACIÓN DE INFRAESTRUCTURA
        stage('Terraform Plan') {
            steps {
                script {
                    echo '--- Planificando Infraestructura ---'
                    
                    // CORRECCIÓN CRÍTICA: Inyectamos las credenciales de AWS
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: AWS_CREDENTIALS_ID, accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                    ]) {
                        dir("${TF_DIR}") {
                            sh 'terraform init'
                            // Terraform ahora usará las variables de entorno inyectadas
                            sh 'terraform plan -out=tfplan' 
                        }
                    }
                }
            }
        }

        // ETAPA 4: DESPLIEGUE (Solo con aprobación)
        stage('Deploy to AWS') {
            input {
                message "¿Desplegar a Producción?"
                ok "Sí, dale"
            }
            steps {
                script {
                    echo '--- Desplegando... (Simulado) ---'
                    
                    // Aseguramos que el 'apply' también use las credenciales
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: AWS_CREDENTIALS_ID, accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                    ]) {
                        dir("${TF_DIR}") {
                             // sh 'terraform apply tfplan' // Deshabilitado para evitar costos
                             echo 'Despliegue de Terraform Apply omitido por seguridad.'
                        }
                    }
                }
            }
        }
    }
}