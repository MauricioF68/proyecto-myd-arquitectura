pipeline {
    agent any

    environment {
        // Rutas de directorio
        TF_DIR = 'infrastructure/terraform'
        BACKEND_DIR = 'backend'
        
        // Configuración de Docker/Redes
        DOCKER_NETWORK = 'proyecto-myd-arquitectura_cicd-net'
        
        // ID de credenciales de Jenkins
        AWS_CREDENTIALS_ID = 'aws-credentials'
        
        // Imagen del escáner de PHP (Nombre local que construiremos)
        SONAR_SCANNER_IMAGE = 'myd-sonar-scanner-php:1.0' 
    }

    stages {

        // ETAPA 1: CONSTRUCCIÓN DEL ESCÁNER PERSONALIZADO
        stage('Build Sonar Scanner Image') {
            steps {
                script {
                    echo "--- Construyendo Imagen Docker de Sonar Scanner PHP 8.1 ---"
                    // Nota: El contexto de build es la raíz (.), el Dockerfile está en infrastructure/docker/
                    sh "docker build -f infrastructure/docker/Dockerfile.sonar-scanner -t ${SONAR_SCANNER_IMAGE} ."
                }
            }
        }

        // ETAPA 2: CALIDAD Y SEGURIDAD
        stage('Quality & Security') {
            parallel {

                // ---- ANÁLISIS SONARQUBE (PHP) ----
                stage('SonarQube Analysis (PHP)') {
                    steps {
                        script {
                            echo '--- Ejecutando Análisis Real de SonarQube con Scanner PHP 8.1 ---'
                            
                            // Aseguramos permisos de lectura/escritura en el host de Jenkins
                            sh "chmod -R 775 ${BACKEND_DIR}" 
                            
                            withSonarQubeEnv('SonarQube Server') {
                                // Usamos comillas simples para evitar la interpolación de Groovy, excepto en las variables ${}
                                // La URL del host se inyecta correctamente como -Dsonar.host.url=http://sonarqube:9000
                                sh "docker run --rm --network ${DOCKER_NETWORK} -v ${WORKSPACE}/${BACKEND_DIR}:/usr/src ${SONAR_SCANNER_IMAGE} -Dsonar.projectBaseDir=/usr/src"
                            }
                        }
                    }
                }

                // ---- ANALISIS DE INFRAESTRUCTURA (CHECKOV) ----
                stage('Infrastructure Security (Checkov)') {
                    steps {
                        script {
                            echo '--- Ejecutando Auditoría de Terraform ---'
                            dir("${TF_DIR}") {
                                // Solución CRÍTICA: Usamos comillas simples (') para aislar el comando shell 
                                // y forzar el uso de la sintaxis shell $(pwd) sin que Groovy interfiera.
                                sh 'docker run --rm -v $(pwd)/../../:/tf bridgecrew/checkov:3 -d /tf/infrastructure/terraform --soft-fail'
                            }
                        }
                    }
                }
            }
        }

        // ETAPA 3: PLANIFICACIÓN DE INFRAESTRUCTURA
        stage('Terraform Plan') {
            steps {
                script {
                    echo '--- Planificando Infraestructura ---'
                    
                    // Inyección de credenciales de AWS
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: AWS_CREDENTIALS_ID, accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                    ]) {
                        dir("${TF_DIR}") {
                            sh 'terraform init'
                            sh 'terraform plan -out=tfplan' 
                        }
                    }
                }
            }
        }

        // ETAPA 4: DESPLIEGUE (Solo con aprobación)
        stage('Deploy to AWS') {
            input {
                message "¿Desplegar a Producción?"
                ok "Sí, dale"
            }
            steps {
                script {
                    echo '--- Desplegando... (Simulado) ---'
                    
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding', credentialsId: AWS_CREDENTIALS_ID, accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                    ]) {
                        dir("${TF_DIR}") {
                             echo 'Despliegue de Terraform Apply omitido por seguridad.'
                        }
                    }
                }
            }
        }
    }
}