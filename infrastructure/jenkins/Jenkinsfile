// -----------------------------------------------------
// JENKINSFILE PROFESIONAL v3.0 (ARQUITECTO DE SISTEMAS)
// Reordenado según solicitud del usuario:
// checkout → build servicios → deploy → sonar al final
// -----------------------------------------------------

pipeline {

    agent any

    environment {
        TF_DIR = 'infrastructure/terraform'
        BACKEND_DIR = 'backend'

        DOCKER_NETWORK = 'proyecto-myd-arquitectura_cicd-net'

        AWS_CREDENTIALS_ID = 'aws-credentials'
        SONARQUBE_TOKEN_ID = 'sonar-token'

        SONAR_SCANNER_IMAGE = 'myd-sonar-scanner-php:1.0'

        CHECKOV_IMAGE = 'bridgecrew/checkov:3'
        TERRAFORM_IMAGE = 'hashicorp/terraform:1.6.0'
    }

    post {
        always {
            echo 'Limpiando contenedores de observabilidad...'
            sh 'docker compose -f docker-compose-cicd.yml down || true'
        }
    }

    stages {

        // -----------------------------------------------------
        // 1) CHECKOUT
        // -----------------------------------------------------
        stage('Checkout') {
            steps {
                echo "--- Realizando Checkout del Repositorio ---"
                checkout scm
            }
        }

        // -----------------------------------------------------
        // 2) BUILD SERVICIOS
        // -----------------------------------------------------

        stage('Build Sonar Scanner Image') {
            steps {
                script {
                    echo "--- Construyendo Imagen Docker de Sonar Scanner PHP 8.1 ---"
                    sh "docker build -f infrastructure/docker/Dockerfile.sonar-scanner -t ${SONAR_SCANNER_IMAGE} ."
                }
            }
        }

        // Terraform Plan (forma parte del build de infraestructura)
        stage('Terraform Plan') {
            agent {
                docker {
                    image "hashicorp/terraform:1.6.0"
                    args "--entrypoint='' -u root"
                }
            }
            steps {
                script {
                    echo '--- Ejecutando Terraform Plan ---'

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: AWS_CREDENTIALS_ID,
                         accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                         secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                    ]) {
                        dir("${TF_DIR}") {
                            sh 'terraform init -backend-config="bucket=myd-tf-state-bucket-unique" -backend-config="key=myd/terraform.tfstate" -input=false'
                            sh 'terraform plan -out=tfplan'
                        }
                    }
                }
            }
        }

        // -----------------------------------------------------
        // 3) DEPLOY SERVICIOS (PRIMERO OBSERVABILIDAD → AWS)
        // -----------------------------------------------------

        stage('Deploy Observability') {
            steps {
                script {
                    echo '--- Desplegando Stack de Observabilidad ---'
                    sh 'docker compose -f docker-compose-cicd.yml up -d'
                    echo 'Prometheus, Grafana y Loki están activos.'
                }
            }
        }

        stage('Deploy to AWS') {
            input {
                message "¿Aplicar Terraform en AWS?"
                ok "Sí, aplicar"
            }
            agent {
                docker {
                    image "${TERRAFORM_IMAGE}"
                }
            }
            steps {
                script {
                    echo '--- Ejecutando Terraform Apply ---'

                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: AWS_CREDENTIALS_ID,
                         accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                         secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                    ]) {
                        dir("${TF_DIR}") {
                            sh 'terraform apply -auto-approve tfplan'
                        }
                    }
                }
            }
        }

        // -----------------------------------------------------
        // 4) SONARQUBE (AL FINAL, COMO PEDISTE)
        // -----------------------------------------------------
        stage('Quality & Security Gate (FINAL)') {
            parallel {

                stage('SonarQube Analysis (PHP)') {
                    agent {
                        docker {
                            image "${SONAR_SCANNER_IMAGE}"
                            args "--entrypoint='' --network ${DOCKER_NETWORK}"
                        }
                    }
                    steps {
                        dir("${BACKEND_DIR}") {
                            script {

                                sh """
                                    echo '--- VERIFICANDO ARCHIVOS EN BACKEND ---'
                                    if [ ! -d "app" ]; then
                                        echo "ERROR: Carpeta app no visible en backend."
                                        ls -l
                                        exit 1
                                    fi
                                """

                                withCredentials([string(credentialsId: SONARQUBE_TOKEN_ID, variable: 'SONAR_TOKEN')]) {
                                    withSonarQubeEnv('SonarQube Server') {
                                        sh """
                                            echo '--- Ejecutando Análisis SonarQube ---'
                                            sonar-scanner \\
                                                -Dsonar.projectBaseDir=. \\
                                                -Dsonar.sources=app,config,routes,database,resources \\
                                                -Dsonar.exclusions=vendor/**,storage/**,bootstrap/cache/**,public/**,node_modules/**,tests/** \\
                                                -Dsonar.login=${SONAR_TOKEN} \\
                                                -Dsonar.projectKey=MYD-LARAVEL-PROJECT \\
                                                -Dsonar.projectName='MyD Cotizaciones Laravel Monolito' \\
                                                -Dsonar.sourceEncoding=UTF-8
                                        """
                                    }
                                }

                                timeout(time: 20, unit: 'MINUTES') {
                                    echo 'Esperando Quality Gate...'
                                    waitForQualityGate abortPipeline: true
                                }
                            }
                        }
                    }
                }

                stage('Infrastructure Security (Checkov)') {
                    agent {
                        docker {
                            image "${CHECKOV_IMAGE}"
                            args "--entrypoint='' -v ${WORKSPACE}/${TF_DIR}:/tf_root"
                        }
                    }
                    steps {
                        script {
                            echo '--- Ejecutando Auditoría de Terraform con Checkov ---'
                            sh "checkov -d /tf_root --framework terraform --soft-fail"
                        }
                    }
                }
            }
        }
    }
}
