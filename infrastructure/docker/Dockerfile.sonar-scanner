# -----------------------------------------------------
# DOCKERFILE SONAR SCANNER PHP 8.1 (SOLUCIÓN MULTI-STAGE)
# -----------------------------------------------------

# 1. Etapa: Obtener el Sonar Scanner CLI (Usando la imagen oficial)
FROM sonarsource/sonar-scanner-cli:5.0 AS scanner

# 2. Etapa: Imagen de ejecución (la base de PHP)
FROM php:8.1-cli

# 3. Instalamos las dependencias necesarias
# openjdk-21-jre-headless es NECESARIO para que Sonar Scanner funcione
RUN apt-get update && \
    apt-get install -y openjdk-21-jre-headless \
    git \
    libxml2-dev \
    libonig-dev \
    && rm -rf /var/lib/apt/lists/*

# 4. Copiamos el binario del Sonar Scanner desde la etapa 'scanner'
# Esto es mucho más robusto que usar curl y unzip.
COPY --from=scanner /opt/sonar-scanner /opt/sonar-scanner

# 5. Configuramos el PATH para que el binario 'sonar-scanner' sea accesible
ENV PATH="/opt/sonar-scanner/bin:${PATH}"

# 6. Punto de entrada (para que pueda ser llamado como un binario simple)
ENTRYPOINT ["sonar-scanner"]