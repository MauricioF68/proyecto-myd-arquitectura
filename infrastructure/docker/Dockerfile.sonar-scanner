# -----------------------------------------------------
# DOCKERFILE SONAR SCANNER PHP 8.1 (CORREGIDO)
# Solución a: Falta de openjdk-17, falta de openjdk-21 en ruta, URL de binarios expirada.
# -----------------------------------------------------

# 1. Imagen Base (PHP 8.1 - CLI)
FROM php:8.1-cli

# 2. Instalamos las dependencias necesarias (Java 21)
RUN apt-get update && \
    # CORRECCIÓN #1 y #2: Instalamos Java 21 headless (funciona en Debian Trixie/12)
    apt-get install -y openjdk-21-jre-headless \
    # Instalamos utilidades necesarias
    curl \
    unzip \
    git \
    libxml2-dev \
    libonig-dev \
    # Limpiamos los caches de APT
    && rm -rf /var/lib/apt/lists/*

# 3. Instalamos el Sonar Scanner CLI 
# CORRECCIÓN #3: Usamos la versión 5.0.0.2796, la última estable verificada que funciona en esta URL.
ARG SONAR_SCANNER_VERSION=5.0.0.2796 
RUN curl -LO https://binaries.sonarsource.com/Distribution/sonar-scanner/sonar-scanner-cli-${SONAR_SCANNER_VERSION}.zip && \
    unzip sonar-scanner-cli-${SONAR_SCANNER_VERSION}.zip -d /opt && \
    rm sonar-scanner-cli-${SONAR_SCANNER_VERSION}.zip

# 4. Configuramos las variables de entorno
ENV SONAR_RUNNER_HOME=/opt/sonar-scanner-${SONAR_SCANNER_VERSION}
ENV PATH=$PATH:/opt/sonar-scanner-${SONAR_SCANNER_VERSION}/bin

# 5. Punto de entrada
ENTRYPOINT ["sonar-scanner"]